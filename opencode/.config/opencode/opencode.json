{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // "browser-auth": {
    //   "type": "remote",
    //   "url": "http://opti.local:8932/mcp",
    //   "enabled": true
    // },
    "browser-lite": {
      "enabled": false, // careful with this, HUGE CONTEXT DRAIN
      "type": "remote",
      "url": "http://opti.local:8931/mcp",
    },
    "engram": {
      "enabled": false,
      "command": [
        "/home/linuxbrew/.linuxbrew/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    },
    // "paper-search": {
    //   "type": "local",
    //   "command": [
    //     "uv",
    //     "run",
    //     "--directory",
    //     "/home/benkalmus/repos/paper-search-mcp",
    //     "-m",
    //     "paper_search_mcp.server"
    //   ]
    // }
  },
  "lsp": {
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh", ".ksh"]
    }
  },
  "permission": {
    "websearch": "allow",
    // safeguards
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".ssh/**": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/credentials": "deny",
      "**/secrets.*": "deny"
    },
    "bash": {
      "cat *.env*": "deny",
      "cat .ssh/*": "deny",
      "cat **/id_rsa*": "deny",
      "cat **/credentials": "deny",
      "head *.env*": "deny",
      "tail *.env*": "deny",
      "less *.env*": "deny",
      "more *.env*": "deny",
      "printenv": "deny",
      "env": "deny",
      "sudo *": "deny",
      "sudo": "deny",
      "git commit * --no-verify": "deny"
    },
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    "./plugins/smartsnip.ts",
    "@tarquinen/opencode-dcp@latest",
    "./plugin/context-usage.ts",
  ],
  "provider": {
    "openrouter": {
      "api": "https://openrouter.ai/api/v1",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B A4B IT",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "google/gemma-4-31b-it": {
          "name": "Gemma 4 31B IT",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen/qwen3.5-397b-a17b": {
          "name": "qwen3.5-397b-a17b",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    },

    "llama-cpp": {
      "api": "http://cachyos.local:9900/v1",
      "options": {
        "apiKey": "noop",
        "baseURL": "http://cachyos.local:9900/v1"
      },
      "models": {
        "qwen-3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B MoE",
          "limit": {
            "context": 85000,
            "output": 32768
          }
        },
        "qwen-3.6-27b": {
          "name": "Qwen 3.6 27B",
          "limit": {
            "context": 85000,
            "output": 32768
          }
        },
        "qwen-3.6-27b-heretic": {
          "name": "Qwen 3.6 27B Heretic",
          "limit": {
            "context": 85000,
            "output": 32768
          }
        }
      }
    }
  }
}
