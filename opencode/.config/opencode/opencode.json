{
  "$schema": "https://opencode.ai/config.json",
  "model":"github-copilot/gpt-5.6-terra",
  "mcp": {
    "engram": {
      "enabled": false,
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    },
  },
  "lsp": {
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh", ".ksh"]
    }
  },
  "agent": {
    "plan": {
      "color": "#1E90FF"
    },
    "build": {
      "color": "#8B0000"
    },
    "coordinator": {
      "mode": "primary",
      // "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "edit": {"*": "ask"},
        "bash": {
          "*": "allow",
          "ls *": "allow",
          "go test *": "allow",
          "go vet *": "allow",
          "go build *": "allow",
          "go tool *": "allow",
          "go mod *": "allow",
          "go fmt *": "allow",
          "go generate*": "deny",
          "golangci-lint *": "allow",
          "make *": "allow",
          "git *": "allow",
          "sed*": "deny",
          "awk*": "deny",
          "tee*": "deny",
        }
      }
    },
    "auditor": {
      "mode": "subagent",
      // "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "edit": {"*": "deny"},
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "grep": "allow",
          "go test *": "allow",
          "go vet *": "allow",
          "go build *": "allow",
          "go tool *": "allow",
          "go mod *": "allow",
          "go fmt *": "allow",
          "go generate*": "deny",
          "golangci-lint *": "allow",
          "git *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git shortlog*": "allow",
        }
      }
    },

    "tester": {
      "mode": "subagent",
      // "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "edit": {"*": "deny", "*_test.go": "allow"},
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "grep": "allow",
          "go test *": "allow",
          "go vet *": "allow",
          "go build *": "allow",
          "go tool *": "allow",
          "go mod *": "allow",
          "go fmt *": "allow",
          "go generate*": "deny",
          "golangci-lint *": "allow",
          "git *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git shortlog*": "allow",
          "sed*": "deny",
          "awk*": "deny",
          "tee*": "deny",
        }
      }
    },
    "producer": {
      "mode": "subagent",
      // "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "edit": {"*": "allow", "*_test.go": "deny"},
        "bash": {
          "*": "deny",
          "rm*": "deny",
          "*rm*": "deny",
          "ls *": "allow",
          "go test*": "allow",
          "go vet*": "allow",
          "go build*": "allow",
          "go tool*": "allow",
          "go mod*": "allow",
          "go fmt*": "allow",
          "go generate*": "deny",
          "go *": "deny",
          "golangci-lint *": "allow",
          "git *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git shortlog*": "allow",
          "sed*": "deny",
          "awk*": "deny",
          "tee*": "deny"
        }
      }
    }
  },
  "permission": {
    "websearch": "allow",
    // safeguards
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".ssh/**": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/credentials": "deny",
      "**/secrets.*": "deny"
    },
    "bash": {
      "cat *.env*": "deny",
      "cat .ssh/*": "deny",
      "cat **/id_rsa*": "deny",
      "cat **/credentials": "deny",
      "head *.env*": "deny",
      "tail *.env*": "deny",
      "less *.env*": "deny",
      "more *.env*": "deny",
      "printenv": "deny",
      "env": "deny",
      "sudo *": "deny",
      "sudo": "deny",
      "git commit *--no-verify*": "deny",
      "rm -f *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask"
    },
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    // "./plugins/smartsnip.ts",
    "@tarquinen/opencode-dcp@latest",
    "./plugin/context-usage.ts",
  ],
  "provider": {
    "llama-cpp": {
      "api": "http://localhost:9900/v1",
      "options": {
        "apiKey": "noop",
        "baseURL": "http://localhost:9900/v1"
      },
      "models": {
        "qwen-3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B MoE",
          "limit": {
            "context": 85000,
            "output": 32768
          }
        },
        "qwen-3.6-27b": {
          "name": "Qwen 3.6 27B",
          "limit": {
            "context": 85000,
            "output": 32768
          }
        }
      }
    }
  }
}
