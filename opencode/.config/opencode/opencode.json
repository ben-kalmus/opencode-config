{
  "$schema": "https://opencode.ai/config.json",
  "websearch": {
    "provider": "exa",
  },
  "mcp": {
    "servers": {
      // "browser-auth": {
      //   "type": "remote",
      //   "url": "http://opti.local:8932/mcp",
      //   "disabled": false
      // },
      "browser-lite": {
        "disabled": true, // careful with this, HUGE CONTEXT DRAIN
        "type": "remote",
        "url": "http://opti.local:8931/mcp",
      },
      "engram": {
        "disabled": true,
        "command": [
          "/home/linuxbrew/.linuxbrew/bin/engram",
          "mcp",
          "--tools=agent"
        ],
        "type": "local"
      },
    }
  },

  // V2 accepts "lsp" but ignores it: no language servers run, no LSP tools or diagnostics.
  // Use project lint, typecheck, or compiler commands instead.
  // "lsp": {
  //   "go": {
  //     "command": ["gopls"],
  //     "extensions": [".go"]
  //   },
  //   "pyright": {
  //     "command": ["pyright-langserver", "--stdio"],
  //     "extensions": [".py", ".pyi"]
  //   },
  //   "bash": {
  //     "command": ["bash-language-server", "start"],
  //     "extensions": [".sh", ".bash", ".zsh", ".ksh"]
  //   }
  // },
  // Custom agents (coordinator, auditor, tester, producer) live in agents/ as markdown files.
  // Their mode, steps, and permissions ride in the frontmatter. Only builtin overrides stay here.

  "agents": {
    "explore": {
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "allow"
        },
      ]
    },
    "plan": {
      "color": "#1E90FF"
    },
    "build": {
      "color": "#8B0000"
    },
  },


  "plugins": [
    "@tarquinen/opencode-dcp@latest",
  ],
  "providers": {
    "enablers": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Enablers",
      "env": ["ENABLERS_JWT"],
      "settings": {
        "apiKey": "{env:ENABLERS_JWT}",
        "baseURL": "https://inference.api.enablers.algolia.net/v1"
      },
      "models": {
        "xlarge": {
          "name": "GLM-5.2",
          "limit": {
            "context": 300000,
            "output": 262144
          }
        }
      }
    },

    "llama-cpp": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "noop",
        "baseURL": "http://localhost:9900/v1"
      },
      "models": {
        "qwen-3.6-27b": {
          "name": "Qwen 3.6 27B",
          "limit": {
            "context": 65000,
            "output": 10000
          }
        },
        "qwen-3.8-27b-q4": {
          "name": "Qwen 3.8 27B Q4",
          "limit": {
            "context": 65000,
            "output": 10000
          },
          "settings": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            },
            {
              "id": "medium",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                },
                "reasoning_budget_tokens": 8000
              }
            },
            {
              "id": "high",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                },
                "reasoning_budget_tokens": 16000
              }
            }
          ]
        }
      }
    }
  },

  // Glob rules: * matches everything including /. ? matches exactly one char. Last matching rule wins.
  // One V2 pattern covers all depths, so per-tool single rules replace the old per-path walls.
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    // safeguards
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".ssh/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/id_rsa",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/id_ed25519",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/secrets.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "head *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "tail *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "less *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "more *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "nl *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rev *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sort *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "od *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "xxd *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.ssh*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *id_rsa*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *id_ed25519*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *credentials*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "printenv",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit *--no-verify*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*<<*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "python* -c*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "node* -e*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "node* --eval*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -f *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -fr *",
      "effect": "ask"
    },
  ]

}
