    //         "output": 65536
    //       }
    //     }
    //   }
    // },

    "llama-cpp": {
      "api": "http://cachyos.local:9900/v1",
      "options": {
        "apiKey": "noop",
        "baseURL": "http://cachyos.local:9900/v1"
      },
      "models": {
        "qwen-3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B MoE",
          "limit": {
            "context": 83000,
            "output": 10000
          }
        },
        "qwen-3.6-27b": {
          "name": "Qwen 3.6 27B",
