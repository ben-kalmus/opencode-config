{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "compress": {
    // "maxContextLimit": "80%",
    // Models get lazy past this point and increasingly expensive.
    // There is no good reason to push context past this point. Better to start new session.
    "maxContextLimit": 120000,
    "modelMaxLimits": {
      "openrouter/deepseek/deepseek-v4-flash": 150000,
      "openrouter/deepseek/deepseek-v4-pro": 150000
    }
    // "modelMinLimits": {
    //   "openrouter/deepseek/deepseek-v4-flash": 250000,
    //   "openrouter/deepseek/deepseek-v4-pro": 250000
    // }
  }
}
