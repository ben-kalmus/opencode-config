{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "engram": {
      "enabled": false,
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    },
  },
  "lsp": {
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh", ".ksh"]
    }
  },
  "agent": {
    "explore": {
      "permission": {
        "external_directory":{
          "*": "allow"
        },
      }
    },
    "plan": {
      "color": "#1E90FF"
    },
    "build": {
      "color": "#8B0000"
    },
    // multi agent hierarchy
    "coordinator": {
      "mode": "primary",
      "permission": {
        // Allow the coordinator the following subagents.
        "task":{
          "*":"ask",
          "general": "deny",
          "scout":"allow",
          "explore":"allow",
          "tester":"allow",
          "producer":"allow",
          "auditor":"allow"
        },

        "edit": {"*": "ask"},
        "bash": {
          "*": "allow",
          "ls *": "allow",
          "go test *": "allow",
          "go vet *": "allow",
          "go build *": "allow",
          "go tool *": "allow",
          "go mod *": "allow",
          "go fmt *": "allow",
          "go generate*": "deny",
          "golangci-lint *": "allow",
          "make *": "allow",
          "find *": "allow",
          "rg*": "allow",
          "git *": "allow",
          "sed*": "deny",
          "awk*": "deny",
          "cat >*": "deny", // Not allowed to make edits
          "echo > *": "deny", // Not allowed to make edits
        }
      }
    },
    "auditor": {
      "mode": "subagent",
      "steps": 30, // auditor gets more steps because it has to read up on more context.
      "permission": {
        // Allow the auditor to explore and scout codebases.
        "task":{
          "*":"deny",
          "scout":"allow",
          "explore":"allow"
        },
        // Since auditor is entirely read-only, it has access to any dir by default.
        "external_directory":{
          "*": "allow"
        },
        "edit": {"*": "deny"},
        "bash": {
          "*": "deny",
          "ls": "allow",
          "head*": "allow",
          "tail*": "allow",
          "grep*": "allow",
          "find *": "allow",
          "rg": "allow",
          "cd *": "allow",
          "grep": "allow",
          "go test *": "allow",
          "go vet *": "allow",
          "go build *": "allow",
          "go tool *": "allow",
          "go mod *": "allow",
          "go fmt *": "allow",
          "golangci-lint *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git shortlog*": "allow",
          "make": "allow",
          "make *": "allow",
        }
      }
    },

    "tester": {
      "mode": "subagent",
      "steps": 18,
        // Forbid the tester from spawning subagents.
      "permission": {
        "task":{
          "*":"deny"
        },
        "edit": {"*": "deny", "*_test.go": "allow"},
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "head*": "allow",
          "tail*": "allow",
          "find *": "allow",
          "rg*": "allow",
          "cd *": "allow",
          "grep*": "allow",
          "go test *": "allow",
          "go vet *": "allow",
          "go build *": "allow",
          "go tool *": "allow",
          "go mod *": "allow",
          "go fmt *": "allow",
          "golangci-lint *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git shortlog*": "allow",
          "make": "allow",
          "make *": "allow",
        }
      }
    },
    "producer": {
      "mode": "subagent",
      "steps": 18, // Limits the agent from going on a thinking spiral.
      "permission": {
        // Forbid the producer from spawning subagents.
        "task":{
          "*":"deny"
        },
        "edit": {"*": "allow", "*_test.go": "deny"},
        "bash": {
          "*": "deny",
          "sed*": "deny",
          "awk*": "deny",
          "rm*": "deny",
          "*rm*": "deny",
          "ls *": "allow",
          "head*": "allow",
          "tail*": "allow",
          "grep*": "allow",
          "find *": "allow",
          "rg*": "allow",
          "xargs": "allow",
          "cd *": "allow",
          "go test*": "allow",
          "go vet*": "allow",
          "go build*": "allow",
          "go tool*": "allow",
          "go mod*": "allow",
          "go fmt*": "allow",
          "golangci-lint *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git shortlog*": "allow",
          "make": "allow",
          "make *": "allow",
        }
      }
    }
  },

  // Global safguards against keys and secrets.
  "permission": {
    "websearch": "allow",
    // safeguards
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".ssh/**": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/credentials": "deny",
      "**/secrets.*": "deny"
    },
    "bash": {
      "cat *.env*": "deny",
      "cat .ssh/*": "deny",
      "cat **/id_rsa*": "deny",
      "cat **/credentials": "deny",
      "head *.env*": "deny",
      "tail *.env*": "deny",
      "less *.env*": "deny",
      "more *.env*": "deny",
      "printenv": "deny",
      "env": "deny",
      "sudo *": "deny",
      "sudo": "deny",
      "git commit *--no-verify*": "deny",
      "rm -f *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask"
    },
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    // "./plugins/smartsnip.ts",
    "@tarquinen/opencode-dcp@latest",
    // "./plugin/context-usage.ts",
  ],
  "provider": {
    "llama-cpp": {
      "api": "http://localhost:9900/v1",
      "options": {
        "apiKey": "noop",
        "baseURL": "http://localhost:9900/v1"
      },
      "models": {
        "qwen-3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B MoE",
          "limit": {
            "context": 83000,
            "output": 10000
          }
        },
        "qwen-3.6-35b-q4-mtp": {
          "name": "qwen-3.6-35b-q4-mtp",
          "limit": {
            "context": 83000,
            "output": 10000
          }
        },
        "qwen-3.6-27b": {
          "name": "Qwen 3.6 27B",
          "limit": {
            "context": 83000,
            "output": 10000
          }
        }
      }
    }
  }
}
