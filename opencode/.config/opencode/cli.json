{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "session.toggle.exploration_grouping": "none",
  // sound when a question is asked.
  "attention": {
    "sound": true
  },
  "keybinds": {
    "leader": "ctrl+b",
    "session.list": "ctrl+s",
    "session.toggle.thinking": "ctrl+y",
    "model.dialog.provider": "ctrl+shift+m",
    "model.list": "ctrl+o",
    "session.new": "ctrl+n",
    // closest V2 equivalent of the old tool_details toggle.
    "session.verbosity.cycle": "<leader>w",
    "agent.cycle": ["tab", "shift+tab"],
    // ctrl+o now opens the model list, so the recent sessions menu loses its default.
    "open.menu": "none",
    // <leader>w now cycles transcript verbosity, so tab close loses its default.
    "session.tab.close": "none",
    // ctrl+b is the leader key, so backgrounding loses its default.
    "session.background": "none"
  },
  "plugins": ["@tarquinen/opencode-dcp@latest", "opencode-subagent-statusline", "/home/benkalmus/work/opencode-openrouter-stats"]
}
