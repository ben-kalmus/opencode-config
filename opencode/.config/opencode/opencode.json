{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browser-auth": {
      "type": "remote",
      "url": "http://optiplex.local:8932/mcp",
      "enabled": true
    },
    "browser-lite": {
      "type": "remote",
      "url": "http://optiplex.local:8931/mcp",
      "enabled": true
    },
    "engram": {
      "command": [
        "/home/linuxbrew/.linuxbrew/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    },
    "paper-search": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/benkalmus/repos/paper-search-mcp",
        "-m",
        "paper_search_mcp.server"
      ]
    }
  },
  "permission": {
    "websearch": "allow"
  },
  "plugin": ["./plugins/caveman/plugin.js", "@tarquinen/opencode-dcp@latest"],
  "provider": {
    "openrouter": {
      "api": "https://openrouter.ai/api/v1",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B A4B IT",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "google/gemma-4-31b-it": {
          "name": "Gemma 4 31B IT",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen/qwen3.5-397b-a17b": {
          "name": "qwen3.5-397b-a17b",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    }
  }
}
